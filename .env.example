# Never sends an order to Polymarket. Keep false for this challenge demo.
POLYMARKET_REAL_PLACEMENTS=false
# Optional: enables the external Gamma/Polymarket discovery fetch.
POLYMARKET_API_ENABLED=true
# Server-side only. Enables OpenRouter-powered market recommendations.
OPENROUTER_API_KEY=
# Optional: defaults to OpenRouter's GPT-5 Mini route.
OPENROUTER_MODEL=openai/gpt-5-mini
